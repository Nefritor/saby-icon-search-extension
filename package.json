{
  "name": "saby-icon-search",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "author": "Хамитов М. А.",
  "saby-version": "26.5100",
  "description": "Chrome extension: sketch an icon on a canvas and find the closest glyphs in the fonts you load",
  "scripts": {
    "build": "npm run typecheck && vite build",
    "build:only": "vite build",
    "dev": "vite",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "idb": "^8.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
