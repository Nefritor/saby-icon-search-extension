{
  "name": "saby-icon-search",
  "private": true,
  "type": "module",
  "version": "2.0.1",
  "author": "Хамитов М. А.",
  "saby-version": "26.5100",
  "description": "Chrome extension: sketch a Saby icon on a canvas and find the closest glyphs in the font",
  "scripts": {
    "build": "npm run typecheck && vite build",
    "build:only": "vite build",
    "dev": "vite",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx scripts/eval.ts",
    "train-ranker": "tsx scripts/train-ranker.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm test",
    "try-sketch": "tsx scripts/try-sketch.ts",
    "real-check": "tsx scripts/real-check.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@heroui/react": "^3.2.6",
    "idb": "^8.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
